#! /usr/bin/env bash

# More info at: https://github.com/elitak/nixos-infect

set -e -o pipefail

STATE_FILE="/tmp/nixos-infect.state"

log() {
  echo "[nixos-infect] $*" >&2
}

check_previous_run() {
  if [[ -e "$STATE_FILE" ]]; then
    log "WARNING: Found state file from previous run at $STATE_FILE"
    log "Previous run may have failed or been interrupted."

    if [[ -e /etc/nixos/configuration.nix ]]; then
      log "Configuration files exist from previous run."
      log "To restart cleanly, run: rm -rf /etc/nixos/ $STATE_FILE"
      log "Or set FORCE_CONTINUE=1 to attempt to continue from where we left off."

      if [[ -z "$FORCE_CONTINUE" ]]; then
        log "Exiting to prevent potential issues. Set FORCE_CONTINUE=1 to override."
        exit 1
      else
        log "FORCE_CONTINUE set, attempting to continue..."
      fi
    fi
  fi
}

mark_state() {
  echo "$1" > "$STATE_FILE"
  log "State: $1"
}

enable_provider_specific_tweaks() {
  # Automatically detects the current cloud provider
  detect_cloud_provider() {
    if [ -e /etc/hetzner-build ]; then
      CLOUD_PROVIDER="hetznercloud"
    fi
  }

  if [ ! -v CLOUD_PROVIDER ]; then
    detect_cloud_provider
  fi

  [ "$CLOUD_PROVIDER" = "lightsail" ] && newrootfslabel="nixos"

  # Some providers require detailed network config to be generated
  if [[ "$CLOUD_PROVIDER" = "digitalocean" ]] || [[ "$CLOUD_PROVIDER" = "servarica" ]] || [[ "$CLOUD_PROVIDER" = "hetznercloud" ]]; then
    log "$CLOUD_PROVIDER requires a detailed network configuration; marking doNetConf=y"
  	doNetConf=y
  fi
}

is_EFI() {
  [ -d /sys/firmware/efi ]
}

find_ESP() {
  esp=""
  for d in /boot/EFI /boot/efi /boot; do
    [[ ! -d "$d" ]] && continue
    mountpoint -q "$d" || continue
    esp="$(df "$d" --output=source | sed 1d)"
    [[ -n "$esp" ]] && break
  done

  # Try to detect unmounted EFI partition
  if [[ -z "$esp" ]]; then
    for dev in /dev/disk/by-label/*; do
      if [[ "$(basename "$dev")" == *"EFI"* ]]; then
        esp="$(readlink -f "$dev")"
        log "WARNING: Found unmounted ESP at $esp"
        break
      fi
    done
  fi

  [[ -z "$esp" ]] && { echo "ERROR: No ESP device found"; return 1; }
  echo "$esp"
}

is_x86_64() {
  [[ "$(uname -m)" == "x86_64" ]]
}

make_nixos_conf() {
  # Generate detailed network configuration if needed
  make_detailed_networking_conf() {
  # XXX It'd be better if we used procfs for all this...
  local IFS=$'\n'
  eth0_name=$(ip address show | grep '^2:' | awk -F': ' '{print $2}')
  eth0_ip4s=$(ip address show dev "$eth0_name" | grep 'inet ' | sed -r 's|.*inet ([0-9.]+)/([0-9]+).*|{ address="\1"; prefixLength=\2; }|')
  eth0_ip6s=$(ip address show dev "$eth0_name" | grep 'inet6 ' | sed -r 's|.*inet6 ([0-9a-f:]+)/([0-9]+).*|{ address="\1"; prefixLength=\2; }|' || true)
  gateway=$(ip route show dev "$eth0_name" | grep default | sed -r 's|default via ([0-9.]+).*|\1|')
  gateway6=$(ip -6 route show dev "$eth0_name" | grep default | sed -r 's|default via ([0-9a-f:]+).*|\1|' || true)
  ether0=$(ip address show dev "$eth0_name" | grep link/ether | sed -r 's|.*link/ether ([0-9a-f:]+) .*|\1|')

  eth1_name=$(ip address show | grep '^3:' | awk -F': ' '{print $2}')||true
  if [ -n "$eth1_name" ];then
    eth1_ip4s=$(ip address show dev "$eth1_name" | grep 'inet ' | sed -r 's|.*inet ([0-9.]+)/([0-9]+).*|{ address="\1"; prefixLength=\2; }|')
    eth1_ip6s=$(ip address show dev "$eth1_name" | grep 'inet6 ' | sed -r 's|.*inet6 ([0-9a-f:]+)/([0-9]+).*|{ address="\1"; prefixLength=\2; }|' || true)
    ether1=$(ip address show dev "$eth1_name" | grep link/ether | sed -r 's|.*link/ether ([0-9a-f:]+) .*|\1|')
    interfaces1=$(cat << EOF
      $eth1_name = {
        ipv4.addresses = [$(for a in "${eth1_ip4s[@]}"; do echo -n "
          $a"; done)
        ];
        ipv6.addresses = [$(for a in "${eth1_ip6s[@]}"; do echo -n "
          $a"; done)
        ];
        };
EOF
)
    extraRules1="ATTR{address}==\"${ether1}\", NAME=\"${eth1_name}\""
  else
    interfaces1=""
    extraRules1=""
  fi

  readarray nameservers < <(grep ^nameserver /etc/resolv.conf | sed -r \
    -e 's/^nameserver[[:space:]]+([0-9.a-fA-F:]+).*/"\1"/' \
    -e 's/127[0-9.]+/8.8.8.8/' \
    -e 's/::1/8.8.8.8/' )

  if [[ "$eth0_name" = eth* ]]; then
    predictable_inames="usePredictableInterfaceNames = lib.mkForce false;"
  else
    predictable_inames="usePredictableInterfaceNames = lib.mkForce true;"
  fi
  cat > /etc/nixos/networking.nix << EOF
{ lib, ... }: {
  # This file was populated at runtime with the networking
  # details gathered from the active system.
  networking = {
    nameservers = [ ${nameservers[@]} ];
    defaultGateway = "${gateway}";
    defaultGateway6 = {
      address = "${gateway6}";
      interface = "${eth0_name}";
    };
    dhcpcd.enable = false;
    $predictable_inames
    interfaces = {
      $eth0_name = {
        ipv4.addresses = [$(for a in "${eth0_ip4s[@]}"; do echo -n "
          $a"; done)
        ];
        ipv6.addresses = [$(for a in "${eth0_ip6s[@]}"; do echo -n "
          $a"; done)
        ];
        ipv4.routes = [ { address = "${gateway}"; prefixLength = 32; } ];
        ipv6.routes = [ { address = "${gateway6}"; prefixLength = 128; } ];
      };
      $interfaces1
    };
  };
  services.udev.extraRules = ''
    ATTR{address}=="${ether0}", NAME="${eth0_name}"
    $extraRules1
  '';
}
EOF
}

  # Generate lightsail configuration
  make_provider_conf_lightsail() {
  mkdir -p /etc/nixos
  cat > /etc/nixos/configuration.nix << EOF
{ config, pkgs, modulesPath, lib, ... }:
{
  imports = [ "\${modulesPath}/virtualisation/amazon-image.nix" ];
  boot.loader.grub.device = lib.mkForce "/dev/nvme0n1";
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
}
EOF
}

  # Make non-provider specific configuration
  make_generic_conf() {
# NB <<"EOF" quotes / $ ` in heredocs, <<EOF does not
  mkdir -p /etc/nixos
  # Prevent grep for sending error code 1 (and halting execution) when no lines are selected : https://www.unix.com/man-page/posix/1P/grep
  local IFS=$'\n'
  for trypath in /root/.ssh/authorized_keys /home/$SUDO_USER/.ssh/authorized_keys $HOME/.ssh/authorized_keys; do
      [[ -r "$trypath" ]] \
      && keys=$(sed -E 's/^[^#].*[[:space:]]((sk-ssh|sk-ecdsa|ssh|ecdsa)-[^[:space:]]+)[[:space:]]+([^[:space:]]+)([[:space:]]*.*)$/\1 \3\4/' "$trypath") \
      && [[ -n "$keys" ]] \
      && break
  done
  local network_import=""

  [[ -n "$doNetConf" ]] && network_import="./networking.nix # generated at runtime by nixos-infect"
  cat > /etc/nixos/configuration.nix << EOF
{ ... }: {
  imports = [
    ./hardware-configuration.nix
    $network_import
    $NIXOS_IMPORT
  ];

  boot.tmp.cleanOnBoot = true;
  zramSwap.enable = ${zramswap};
  networking.hostName = "$(hostname -s)";
  networking.domain = "$(hostname -d)";
  services.openssh.enable = true;
  users.users.root.openssh.authorizedKeys.keys = [$(while read -r line; do
    line=$(echo -n "$line" | sed 's/\r//g')
    trimmed_line=$(echo -n "$line" | xargs)
    echo -n "''$trimmed_line'' "
  done <<< "$keys")];
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  system.stateVersion = "25.11";
}
EOF

  if is_EFI; then
    bootcfg=$(cat << EOF
  boot.loader.grub = {
    efiSupport = true;
    efiInstallAsRemovable = true;
    device = "nodev";
  };
  fileSystems."/boot" = { device = "$esp"; fsType = "vfat"; };
EOF
)
  else
    bootcfg=$(cat << EOF
  boot.loader.grub.device = "$grubdev";
EOF
)
  fi

  availableKernelModules=('"ata_piix"' '"uhci_hcd"' '"xen_blkfront"')
  if is_x86_64; then
    availableKernelModules+=('"vmw_pvscsi"')
  fi

  # If you rerun this later, be sure to prune the filesSystems attr
  cat > /etc/nixos/hardware-configuration.nix << EOF
{ modulesPath, ... }:
{
  imports = [ (modulesPath + "/profiles/qemu-guest.nix") ];
$bootcfg
  boot.initrd.availableKernelModules = [ ${availableKernelModules[@]} ];
  boot.initrd.kernelModules = [ "nvme" ];
  fileSystems."/" = { device = "$rootfsdev"; fsType = "$rootfstype"; };
  $swapcfg
}
EOF
  }

  if [[ -e /etc/nixos/configuration.nix ]]; then
    log "Configuration already exists at /etc/nixos/configuration.nix, skipping generation of configuration.nix and other *.nix files"
    return 0
  fi

  log "Generating NixOS configuration..."

  # Lightsail config is not like the others
  if [ "$CLOUD_PROVIDER" = "lightsail" ]; then
    make_provider_conf_lightsail
    return 0
  fi

  make_generic_conf

  if [[ -n "$doNetConf" ]]; then
    make_detailed_networking_conf
  fi
}

check_existing_swap() {
  SWAPSHOW=$(swapon --show --noheadings --raw)
  zramswap=true
  swapcfg=""
  if [[ -n "$SWAPSHOW" ]]; then
    SWAP_DEVICE="${SWAPSHOW%% *}"
    if [[ "$SWAP_DEVICE" == "/dev/"* ]]; then
      zramswap=false
      swapcfg="swapDevices = [ { device = \"${SWAP_DEVICE}\"; } ];"
      NO_SWAP=true
    fi
  fi
}

make_swap() {
  swapFile=$(mktemp /tmp/nixos-infect.XXXXX.swp)
  dd if=/dev/zero "of=$swapFile" bs=1M count=$((1*1024))
  chmod 0600 "$swapFile"
  mkswap "$swapFile"
  swapon -v "$swapFile"
}

remove_swap() {
  swapoff -a
  rm -vf /tmp/nixos-infect.*.swp
}

prepare_environment() {
  log "Preparing environment..."

  # $esp and $grubdev are used in makeConf()
  if is_EFI; then
    esp="$(find_ESP)" || { log "Cannot continue: EFI system but no ESP found"; exit 1; }
    log "Found ESP: $esp"
  else
    for grubdev in /dev/vda /dev/sda /dev/xvda /dev/nvme0n1; do
      [[ -e $grubdev ]] && break
    done
    log "Using GRUB device: $grubdev"
  fi

  # Retrieve root fs block device
  #                   (get root mount)  (get partition or logical volume)
  rootfsdev=$(mount | grep "on / type" | awk '{print $1;}')
  rootfstype=$(df "$rootfsdev" --output=fstype | sed 1d)
  log "Root filesystem: $rootfsdev ($rootfstype)"

  # DigitalOcean doesn't seem to set USER while running user data
  export USER="root"
  export HOME="/root"

  # Nix installer tries to use sudo regardless of whether we're already uid 0
  #which sudo || { sudo() { eval "$@"; }; export -f sudo; }
  # shellcheck disable=SC2174
  mkdir -p -m 0755 /nix
}

# Check environment and dependencies
check_environment() {
  # Check if a package is installed
  request_package() {
    type "$1" > /dev/null 2>&1 || which "$1" > /dev/null 2>&1
  }

  # Return a list of packages that are missing
  get_missing_packages() {
    local -n missing_packages=$1             # use nameref for indirection

    # Get list of missing packages
    if ! request_package curl; then missing_packages+=("curl"); fi
    if ! request_package bzcat; then missing_packages+=("bzcat"); fi
    if ! request_package xzcat; then missing_packages+=("xzcat"); fi
    if ! request_package groupadd; then missing_packages+=("groupadd"); fi
    if ! request_package useradd; then missing_packages+=("useradd"); fi
    if ! request_package ip; then missing_packages+=("ip"); fi
    if ! request_package awk; then missing_packages+=("awk"); fi
    if ! request_package cut || ! request_package df; then missing_packages+=("coreutils"); fi
    if ! request_package parted; then missing_packages+=("parted"); fi
  }

  log "Checking environment and dependencies..."

  [[ "$(whoami)" == "root" ]] || { log "ERROR: Must run as root"; return 1; }

  # Install missing packages if any
  local pkgs_to_install
  get_missing_packages pkgs_to_install
  if [[ -n "$pkgs_to_install" ]]; then
    if which apt-get; then
      apt-get update
      apt-get install -y "$pkgs_to_install"
    elif which yum; then
      yum install -y "$pkgs_to_install"
    fi

    # Check if any packages were still missing after installation
    local pkgs_still_missing
    get_missing_packages pkgs_still_missing
    if [[ -n "$pkgs_still_missing" ]]; then
      log "ERROR: Dependencies still missing after installation"
      log "Missing packages: " "${pkgs_still_missing[@]}"
      return 1
    fi
  fi

  # On some versions of Oracle Linux these have the wrong permissions,
  # which stops sshd from starting when NixOS boots
  chmod 600 /etc/ssh/ssh_host_*_key 2>/dev/null || true

  log "All dependencies satisfied"
}

# Infect the system with NixOS
infect() {
  setup_nixos() {
    # Add nix build users
      # FIXME run only if necessary, rather than defaulting true
      groupadd nixbld -g 30000 2>/dev/null || true
      for i in {1..10}; do
        useradd -c "Nix build user $i" -d /var/empty -g nixbld -G nixbld -M -N -r -s "$(which nologin)" "nixbld$i" 2>/dev/null || true
      done

      mark_state "installing_nix"

      NIX_INSTALL_URL="${NIX_INSTALL_URL:-https://nixos.org/nix/install}"
      log "Installing Nix from $NIX_INSTALL_URL"
      curl -L "${NIX_INSTALL_URL}" | sh -s -- --no-channel-add

      # shellcheck disable=SC1090
      source ~/.nix-profile/etc/profile.d/nix.sh

      mark_state "configuring_channels"

      [[ -z "$NIX_CHANNEL" ]] && NIX_CHANNEL="nixos-25.11"
      log "Setting up NixOS channel: $NIX_CHANNEL"
      nix-channel --remove nixpkgs
      nix-channel --add "https://nixos.org/channels/$NIX_CHANNEL" nixos
      nix-channel --update

      if [[ $NIXOS_CONFIG = http* ]]
      then
        curl "$NIXOS_CONFIG" -o /etc/nixos/configuration.nix
        unset NIXOS_CONFIG
      fi

      export NIXOS_CONFIG="${NIXOS_CONFIG:-/etc/nixos/configuration.nix}"

      mark_state "building_system"

      log "Building NixOS system profile..."
      nix-env --set \
        -I nixpkgs="$(realpath $HOME/.nix-defexpr/channels/nixos)" \
        -f '<nixpkgs/nixos>' \
        -p /nix/var/nix/profiles/system \
        -A system

      # Remove nix installed with curl | bash
      rm -fv /nix/var/nix/profiles/default*
      /nix/var/nix/profiles/system/sw/bin/nix-collect-garbage

      # Reify resolv.conf
      [[ -L /etc/resolv.conf ]] && mv -v /etc/resolv.conf /etc/resolv.conf.lnk && cat /etc/resolv.conf.lnk > /etc/resolv.conf

      # Set label of root partition
      if [ -n "$newrootfslabel" ]; then
        log "Setting label of $rootfsdev to $newrootfslabel"
        e2label "$rootfsdev" "$newrootfslabel"
      fi

      mark_state "staging_boot"

      # Stage the Nix coup d'état
      log "Staging NixOS takeover..."
      touch /etc/NIXOS
      {
        echo etc/nixos
        echo etc/resolv.conf
        echo root/.nix-defexpr/channels
      } >> /etc/NIXOS_LUSTRATE
      if cd / && ls etc/ssh/ssh_host_*_key* 2>/dev/null; then
        (cd / && ls etc/ssh/ssh_host_*_key*) >> /etc/NIXOS_LUSTRATE
      fi
  }

  resize_boot_partition() {
    if ! is_EFI; then
      log "Not an EFI system, skipping boot partition size check"
      return 0
    fi

    local esp_dev="$1"
    local esp_dev_real
    local MIN_BOOT_SIZE_MB=1024
    esp_dev_real=$(readlink -f "$esp_dev")

    # Get current boot partition size in MB
    local current_size_kb
    local current_size_mb
    current_size_kb=$(lsblk -bno SIZE "$esp_dev_real" | head -1)
    current_size_mb=$((current_size_kb / 1024 / 1024))

    log "Current boot partition size: ${current_size_mb}MB"

    if [[ $current_size_mb -ge $MIN_BOOT_SIZE_MB ]]; then
      log "Boot partition size is adequate (${current_size_mb}MB >= ${MIN_BOOT_SIZE_MB}MB)"
      return 0
    fi

    log "Boot partition is too small (${current_size_mb}MB < ${MIN_BOOT_SIZE_MB}MB), resizing..."

        # Safely move or copy boot contents

    if mountpoint -q /boot; then
      # Back up boot partition contents
      local boot_backup="/tmp/boot-backup-$"
      mkdir -p "$boot_backup"
      log "Backing up boot partition to $boot_backup"
      cp -a /boot/* "$boot_backup/" || true

      # Unmount the boot partition
      umount /boot || { echo "ERROR: Failed to unmount /boot"; return 1; }
    else
      log "WARNING: /boot is not mounted, will proceed without backup"
      boot_backup=""
    fi

    # Extract partition number and disk from device
    local part_num
    local disk_dev

    part_num="$(lsblk -no PARTNUM "$esp_dev_real")"
    disk_dev="/dev/$(lsblk -no PKNAME "$esp_dev_real")"

    if [[ -z "$part_num" || -z "$disk_dev" ]]; then
      log "ERROR: Failed to determine disk or partition number for $esp_dev_real"
      return 1
    fi

    log "Disk: $disk_dev, Partition: $part_num"

    # Get partition start sector (handle both single and double-digit partition numbers)
    local part_start
    part_start=$(parted -s "$disk_dev" unit s print | grep "^[[:space:]]*${part_num}[[:space:]]" | awk '{print $2}' | sed 's/s$//')

    if [[ -z "$part_start" ]]; then
      log "ERROR: Could not determine partition start sector"
      log "parted output:"
      parted -s "$disk_dev" unit s print
      return 1
    fi

    log "Partition starts at sector: $part_start"

    # Use sfdisk to resize the partition non-interactively
    log "Recreating partition ${part_num} with ${MIN_BOOT_SIZE_MB}MB size..."
    echo "${part_start},${MIN_BOOT_SIZE_MB}M,U,*" | sfdisk --no-reread --force "$disk_dev" -N "$part_num"

    # Wait for device to be ready
    sleep 2
    partprobe "$disk_dev" || true
    sleep 2

    # Format the new partition
    log "Formatting new boot partition..."
    mkfs.vfat -F32 "$esp_dev_real"

    log "Boot partition successfully resized to ${MIN_BOOT_SIZE_MB}MB"
    return 0
  }

  log "Beginning NixOS infection process..."

  setup_nixos

  if is_EFI; then
    umount --quiet "$esp" || true
    resize_boot_partition "$esp"
    mkdir -p /boot
    mount "$esp" /boot
    find /boot -depth ! -path /boot -exec rm -rf {} +
  fi

  log "Installing bootloader..."
  /nix/var/nix/profiles/system/bin/switch-to-configuration boot

  mark_state "complete"
  rm -f "$STATE_FILE"

  log "NixOS infection complete!"
}


### Main execution

check_previous_run
enable_provider_specific_tweaks
check_environment
prepare_environment
check_existing_swap

if [[ -z "$NO_SWAP" ]]; then
    log "Creating temporary swap space..."
    make_swap
fi

make_nixos_conf
infect

if [[ -z "$NO_SWAP" ]]; then
    log "Removing temporary swap space..."
    remove_swap
fi

if [[ -z "$NO_REBOOT" ]]; then
  log "Rebooting into NixOS in 5 seconds..."
  sleep 5
  reboot
else
  log "NO_REBOOT set, skipping automatic reboot"
  log "Run 'reboot' manually to boot into NixOS"
fi
